{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ichizen.local/schema/schema-release.schema.json",
  "title": "Ichizen Esqyma schema release",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format_version",
    "release",
    "dialect",
    "created_at",
    "atlas",
    "bootstrap",
    "seed_contract"
  ],
  "properties": {
    "format_version": {
      "enum": [
        1,
        2
      ]
    },
    "release": {
      "type": "string",
      "pattern": "^postgres/[0-9]{4}\\.[0-9]{2}\\.[1-9][0-9]*$"
    },
    "dialect": {
      "const": "postgres"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "atlas": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tool_version",
        "head",
        "revision_count",
        "sum_sha256",
        "tracker_fingerprint"
      ],
      "properties": {
        "tool_version": {
          "const": "1.3.0"
        },
        "head": {
          "type": "string",
          "pattern": "^[0-9]{14}$"
        },
        "revision_count": {
          "type": "integer",
          "minimum": 1
        },
        "sum_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "tracker_fingerprint": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "bootstrap": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "pg_dump_version",
        "restrict_key",
        "normalized_schema_fingerprint",
        "catalog_fingerprint"
      ],
      "properties": {
        "path": {
          "const": "bootstrap.sql"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "pg_dump_version": {
          "const": "18.3"
        },
        "restrict_key": {
          "$ref": "#/$defs/sha256"
        },
        "normalized_schema_fingerprint": {
          "$ref": "#/$defs/sha256"
        },
        "catalog_fingerprint": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "seed_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "bundle_manifest_version",
        "allowed_profiles"
      ],
      "properties": {
        "id": {
          "const": "copya/v1"
        },
        "bundle_manifest_version": {
          "const": 1
        },
        "allowed_profiles": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          }
        },
        "compatible_schema_releases": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^postgres/[0-9]{4}\\.[0-9]{2}\\.[1-9][0-9]*$"
          }
        }
      }
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "phase",
        "api_reference",
        "minimum_operator_version",
        "oracles",
        "upgrades"
      ],
      "properties": {
        "phase": {
          "enum": [
            "expand",
            "contract"
          ]
        },
        "api_reference": {
          "type": "string",
          "minLength": 1
        },
        "minimum_operator_version": {
          "type": "integer",
          "minimum": 2
        },
        "oracles": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          }
        },
        "upgrades": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "from_release",
              "from_manifest_sha256",
              "from_tracker_fingerprint",
              "tracker_fingerprint"
            ],
            "properties": {
              "from_release": {
                "type": "string",
                "pattern": "^postgres/[0-9]{4}\\.[0-9]{2}\\.[1-9][0-9]*$"
              },
              "from_manifest_sha256": {
                "$ref": "#/$defs/sha256"
              },
              "from_tracker_fingerprint": {
                "$ref": "#/$defs/sha256"
              },
              "tracker_revision_count": {
                "type": "integer",
                "minimum": 1
              },
              "tracker_fingerprint": {
                "$ref": "#/$defs/sha256"
              }
            }
          }
        },
        "legacy_installations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "tracker_revision_count",
              "tracker_fingerprint"
            ],
            "properties": {
              "tracker_revision_count": {
                "type": "integer",
                "minimum": 1
              },
              "tracker_fingerprint": {
                "$ref": "#/$defs/sha256"
              }
            }
          }
        },
        "data_oracles": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "sql",
              "sql_sha256",
              "mode",
              "max_rows",
              "timeout_seconds"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
              },
              "sql": {
                "type": "string",
                "minLength": 1,
                "maxLength": 16384
              },
              "sql_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "mode": {
                "enum": [
                  "unchanged",
                  "zero-rows"
                ]
              },
              "max_rows": {
                "type": "integer",
                "minimum": 1,
                "maximum": 10000
              },
              "timeout_seconds": {
                "type": "integer",
                "minimum": 1,
                "maximum": 30
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "format_version": {
            "const": 1
          }
        }
      },
      "then": {
        "not": {
          "required": [
            "compatibility"
          ]
        },
        "properties": {
          "seed_contract": {
            "not": {
              "required": [
                "compatible_schema_releases"
              ]
            }
          }
        }
      },
      "else": {
        "required": [
          "compatibility"
        ]
      }
    }
  ]
}
